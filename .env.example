# --- Banco de Dados (MySQL) ---
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=credenciamento_daiaplam
MYSQL_USER=codego_app
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
# Banco gerenciado fora da máquina (ex.: Aiven): conexão com SSL.
MYSQL_SSL=false
MYSQL_SSL_CA=

# --- Backend (FastAPI) ---
APP_ENV=development
# Em produção: valor longo e aleatório (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))")
APP_SECRET_KEY=change_me_secret
APP_PORT=8000

# --- Publicação ---
# Endereços do site que podem chamar a API, separados por vírgula ("*" = qualquer um).
# Em produção, deixe "*" (só o próprio site fala com a API) ou liste o endereço do site.
CORS_ORIGINS=*
# Servir o site (pasta frontend/) pelo próprio backend (ex.: Render).
SERVIR_FRONTEND=false
# VM da CODEGO (deploy/README.md): porta em que o sistema responde. Padrão 8081.
#PORTA_HTTP=8081

# --- reCAPTCHA (v2 "Não sou um robô") ---
# Desligado por padrão -- útil para rodar local sem chaves reais. Em produção (Render), ligado.
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=

# --- E-mail (Brevo, pela API HTTPS -- funciona no Render, que bloqueia SMTP) ---
# Vazio = desligado. Para ligar: EMAIL_PROVIDER=brevo_api, chave da API e remetente VERIFICADO na Brevo.
EMAIL_PROVIDER=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Credenciamento DAIAPLAM - CODEGO
# Cópia de cada envio finalizado (respostas e arquivos) para a CODEGO. Vazio = não manda.
EMAIL_CODEGO=edital@codego.com.br
# Endereço público do site (aparece no e-mail de cadastro). Opcional.
SITE_URL=

# --- Sessão (JWT) ---
TOKEN_EXPIRA_MINUTOS=60

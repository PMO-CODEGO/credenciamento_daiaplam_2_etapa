# Site do Credenciamento DIANOT no Caddy do Sistema Cadastral (mesma VM).
# Copiar para C:\sistema_cadastral_codego\deploy\sites\ e trocar o domínio
# abaixo pelo subdomínio criado pelo TI. Ver deploy/README.md, passo 6.

credenciamento.codego.com.br {
	encode gzip

	# Documentos do credenciamento: até 20 MB por arquivo.
	request_body {
		max_size 25MB
	}

	# O backend serve o site e a API (porta PORTA_HTTP do .env, padrão 8081).
	reverse_proxy host.docker.internal:8081
}
